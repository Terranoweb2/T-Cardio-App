# ============================================
# T-CARDIO PRO - ENVIRONMENT CONFIGURATION
# ============================================

# Server
NODE_ENV=development
PORT=3001

# Database (Prisma)
DATABASE_URL=postgresql://tcardio:tcardio_dev_2024@localhost:5432/tcardio_pro

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=dev_jwt_secret_change_in_production_min_256_bits_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_here
JWT_REFRESH_EXPIRES_IN=7d

# DeepSeek AI
DEEPSEEK_API_KEY=sk-placeholder-replace-with-real-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MinIO Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=tcardio-reports
MINIO_USE_SSL=false

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:19006
ENCRYPTION_KEY=dev_encryption_key_32_bytes_long!!

# ============================================
# Paiement MTN MoMo (API Collections officielle)
# ============================================
# Si ces variables sont vides, l'app retombe sur le flux manuel USSD + validation admin.
# Sandbox  : MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com, MOMO_TARGET_ENVIRONMENT=sandbox, MOMO_CURRENCY=EUR
# Prod CI  : MOMO_BASE_URL=https://proxy.momoapi.mtn.com,        MOMO_TARGET_ENVIRONMENT=mtnci,   MOMO_CURRENCY=XOF
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR
MOMO_COUNTRY_CODE=225
# Cle d'abonnement du produit "Collections" (Ocp-Apim-Subscription-Key)
MOMO_SUBSCRIPTION_KEY=
# Identifiants API (sandbox: generes par scripts/momo-sandbox-setup.ts ; prod: Partner Portal MTN)
MOMO_API_USER=
MOMO_API_KEY=
# URL de callback (le HOST doit correspondre au providerCallbackHost enregistre)
MOMO_CALLBACK_URL=https://t-cardio.org/api/v1/payments/momo/callback

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_EMERGENCY_ALERTS=true
ENABLE_TELECONSULTATION=true
